# Postgres connection string (Railway Postgres service -> "Connect" tab -> DATABASE_URL)
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Linear (which team/project/label each audit reads from is configured per
# Scope in the app at /scopes, not here -- see the Scope model)
LINEAR_API_KEY="lin_api_xxx"

# Anthropic
ANTHROPIC_API_KEY="sk-ant-xxx"
AUDIT_MODEL="claude-sonnet-4-6"

# Notion (optional) -- lets Scopes pull requirements/scoping pages in as
# estimator context. Create an internal integration at
# notion.so/my-integrations, then share each page with it (page menu ->
# Connections). Without this key, Notion fields are simply ignored.
NOTION_API_KEY="ntn_xxx"

# Figma (optional) -- lets Scopes pull design pages/frames in as estimator
# context (screen/flow names, on-canvas text). Generate a personal access
# token at figma.com -> account settings -> Security -> Personal access
# tokens. No per-file sharing step needed (unlike Notion) -- the token's
# owner just needs access to the file in Figma already.
FIGMA_API_KEY="figd_xxx"

# Single shared password gating the whole app (httpOnly cookie, see middleware.ts)
APP_PASSWORD="change-me"

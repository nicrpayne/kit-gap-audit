generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scope {
  id           String    @id @default(cuid())
  name         String // e.g. "JSA", "iTrack", "Precon"
  teamKey      String // e.g. "SOF" -- will repeat across scopes
  projectNames String[] @default([]) // Linear projects to filter to (union, no double-count within one Scope's own simulation), e.g. ["KIT JSA", "KIT Platform"]. Empty = any project.
  labelFilter  String? // optional label name to further narrow, e.g. "JSA"
  targetDate   DateTime? // release target the Forecast confidence is measured against
  teamCapacity Float? // parallel "developer equivalents"; null = infer from assignees
  includeTriage Boolean  @default(false) // count Triage-state tickets in the Forecast (audit always sees them)
  estimationContext String? // free text fed to the AI estimator: team makeup, stack, what this release is
  notionPageIds String[] @default([]) // Notion requirements/scoping pages pulled in as estimator context
  figmaRefs     String[] @default([]) // "fileKey:nodeId" design pages/frames pulled in as estimator context
  // Other Scope ids this Scope's forecast can't finish ahead of -- e.g.
  // JSA/iTrack depending on shared Platform work. Modeled per trial as
  // max(this scope's own days, a draw from each dependency's own
  // completion-day samples), see lib/forecast/portfolio.ts. Empty (the
  // default, true for every Scope before this field existed) means a
  // Scope's forecast is computed exactly as it always was.
  dependsOnScopeIds String[] @default([])
  createdAt    DateTime  @default(now())
  sources      Source[]
  reports      Report[]
  contextDocs  ContextDoc[]
  allocations  Allocation[]
  contextSnapshots ContextSnapshot[]
  decisions    Decision[]
  gatedBy      DecisionGate[] @relation("GatedScope")
  decisionCandidates DecisionCandidate[]
  timelineEvents     TimelineEvent[]
  timelineEventCandidates TimelineEventCandidate[]
}

// Tracking POLICY for a recurring source -- "should we currently keep
// looking at this," independent from any specific content. Deliberately a
// thin layer that references existing content (a ContextDoc id/label, a
// Notion page id, a Figma ref key) by id rather than owning it -- content
// ingestion is unchanged (ContextDoc/Notion/Figma/Source stay exactly as
// they are). Not every piece of context needs a row here: a one-off pasted
// transcript audited once never gets registered. Registration is reserved
// for things meant to be repeatedly relied on and reviewed. Linear itself
// is deliberately NOT registered here -- it's a structural source via
// Scope.projectNames/teamKey, not something with a candidate/retired
// lifecycle (see docs/CONTEXT-MODEL.md).
model SourceRegistration {
  id         String   @id @default(cuid())
  sourceType String // "notion" | "figma" | "contextDoc" | "spreadsheet" | ...
  sourceRef  String // Notion page id / Figma "fileKey:nodeId" / ContextDoc id or label

  // Which Scopes this applies to. Empty = portfolio-wide, mirroring
  // Scope.projectNames' existing "empty = any project" convention rather
  // than a join table.
  scopeIds String[] @default([])

  // ROLE and STATUS are independent axes on purpose (see docs/CONTEXT-MODEL.md):
  // role = how authoritative this source is for the facts it contains while
  // tracked; status = whether it's currently tracked at all. A source can
  // stay "active" while its role changes from operational_tracker to
  // supplemental_context once execution moves elsewhere.
  role   String // "operational_tracker" | "requirements_of_record" | "design_reference" | "supplemental_context" | "raw_evidence"
  status String @default("candidate") // "candidate" | "active" | "paused" | "superseded" | "retired"

  rationale       String? // human-readable "why is this tracked"
  statusReason    String? // human-readable "why is the CURRENT status what it is" -- required by the API on every status change
  statusChangedAt DateTime?

  // Unambiguous replacement pointer -- set ONLY when the replacement is
  // itself a tracked source. When the replacement is a structural source
  // (e.g. Linear), statusReason carries the explanation in prose instead;
  // this field is never a free-text label standing in for an id.
  supersededByRegistrationId String?
  supersededByRegistration   SourceRegistration?  @relation("SourceSupersession", fields: [supersededByRegistrationId], references: [id])
  supersededSources          SourceRegistration[] @relation("SourceSupersession")

  createdAt DateTime @default(now())
}

// One immutable, frozen instance of a ProjectContextPackage (see
// lib/context/package.ts) -- the historical input boundary. Created ONLY
// by lib/context/snapshot.ts's persistContextSnapshot(), and only at a
// deliberate moment (never on an ordinary /forecast page load -- see
// docs/CONTEXT-MODEL.md). Never updated after creation: a later
// SourceRegistration status change must never alter what an existing
// ContextSnapshot says it used.
model ContextSnapshot {
  id      String  @id @default(cuid())
  scopeId String // Phase 1a is single-scope only; portfolio-wide snapshots are explicitly deferred
  scope   Scope   @relation(fields: [scopeId], references: [id])

  // packageId + producer are the PRODUCER's own transport identity for
  // this package instance (independent from this row's own `id`) -- the
  // unique constraint below is what makes a retried push idempotent
  // instead of creating a duplicate snapshot.
  packageId      String
  packageVersion String
  producer       String // "hermes" | "manual" | "gap_app"

  package             Json // the full accepted ProjectContextPackage, verbatim -- the PRODUCER's own claims, unmodified
  contextHash         String // deterministic hash of the package (lib/context/hash.ts)
  // GAP-APP-EVALUATED completeness (lib/context/sourcePolicy.ts), computed
  // against current SourceRegistration Reality at acceptance time -- NOT
  // a copy of package.completeness above, which is the producer's own
  // (unverified) claim and is preserved only for historical record.
  completenessSummary Json

  createdAt DateTime @default(now())

  findings  Finding[]
  reports   Report[]
  auditRuns AuditRun[]
  timelineEvents TimelineEvent[]

  @@unique([producer, packageId])
}

// A named team member. Deliberately lightweight (not a generic HR/user
// system) -- Nic explicitly wants to model "Sam is 60% JSA," not just an
// anonymous headcount integer, since that's what makes the portfolio
// capacity pool answerable ("if we hire 5 and put 3 on JSA...").
model Person {
  id          String       @id @default(cuid())
  // A LABEL, NOT AN IDENTITY. "Person 07" and "Alice" are the same unit of
  // capacity; renaming one must not move a forecast by a single day. The
  // mixer works entirely in anonymous units, and a real name is a
  // convenience for humans reading the screen, never an input to the math.
  name        String
  fte         Float        @default(1.0) // 1.0 = full-time; e.g. 0.5 for a part-time consultant
  active      Boolean      @default(true)
  // Generated by scripts/migrate-embodied-capacity.ts to stand in for a
  // legacy Scope.teamCapacity number, which described a team without
  // saying who was on it. Flagged so the migration is reversible and so
  // the Master bus can say honestly how much of the workforce is inherited
  // assumption rather than someone Nic has actually named.
  synthetic   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  allocations Allocation[]
}

// What share of one Person's time goes to one Scope. `fraction` is out of
// that person's own time (not a global FTE number -- multiply by
// Person.fte to get an FTE contribution). A person's fractions across all
// their Allocations should sum to <= 1.0 -- validated in
// lib/capacity/resolve.ts, never silently clamped.
model Allocation {
  id       String @id @default(cuid())
  personId String
  scopeId  String
  fraction Float
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  scope    Scope  @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([personId, scopeId])
}

// Single-row settings table for portfolio-wide knobs. Not per-Scope
// because context-switching cost is a property of how people split their
// time, not of any one Scope.
model PortfolioSettings {
  id                   String   @id @default("singleton")
  // % capacity lost per additional scope a person is split across, applied
  // to that person's allocations everywhere. 0 (default) = no penalty --
  // never inferred or defaulted to a nonzero value; if Nic sets it, it's
  // his stated assumption, not a baked-in industry number.
  contextSwitchCostPct Int      @default(0)
  updatedAt            DateTime @updatedAt
}

// Pasted/uploaded context that doesn't have a live API to sync from
// (spreadsheet exports, meeting notes, anything else) -- same role as a
// Notion doc in the estimator context, just not kept in sync automatically.
// Re-paste to update; the updated content re-triggers estimate staleness
// the same way an edited Notion doc does.
model ContextDoc {
  id        String   @id @default(cuid())
  scopeId   String
  scope     Scope    @relation(fields: [scopeId], references: [id])
  label     String // e.g. "JSA Infra Alignment working doc (2026-07-30)"
  content   String
  createdAt DateTime @default(now())
}

// A generated leadership update, immutable once created -- rendered text
// is stored (not recomputed on view) so past reports stay exactly what was
// actually reported even as the underlying logic changes later, and
// "since last report" diffing has a stable prior snapshot to compare to.
model Report {
  id                 String   @id @default(cuid())
  scopeId            String
  scope              Scope    @relation(fields: [scopeId], references: [id])
  generatedAt        DateTime @default(now())
  targetDate         DateTime?
  likelyDate         DateTime
  earliestDate       DateTime
  latestDate         DateTime
  confidenceAtTarget Int?
  likelyDateDeltaDays Int?    // vs. the previous report for this scope, null if first
  shippedCount       Int
  blockingCount      Int
  resolvedSinceLastCount Int
  summaryMarkdown    String  // the full rendered report -- the historical record

  // Which ContextSnapshot (if any) fed the computation this Report was
  // generated from. Nullable -- every Report predating this field, and
  // every Report generated before Phase 1b wires snapshot creation into
  // generateReport(), has none. Deliberately a single FK, not a parallel
  // "sourcesUsed" JSON manifest -- ContextSnapshot.package already is the
  // full manifest; a Report should reference it, not duplicate it.
  contextSnapshotId  String?
  contextSnapshot    ContextSnapshot? @relation(fields: [contextSnapshotId], references: [id])
}

// An AI-produced three-point estimate for one work item, cached by content
// hash so unchanged tickets are never re-estimated. Keyed by (source,
// externalId) rather than anything Linear-specific so a Notion requirement
// row can flow through the same pipeline later.
model WorkEstimate {
  id          String   @id @default(cuid())
  scopeId     String
  source      String   @default("linear") // "linear" | future: "notion"
  externalId  String // e.g. "SOF-123"
  contentHash String // hash of title+description+points at estimation time
  lowDays     Float
  likelyDays  Float
  highDays    Float
  rationale   String
  relevance   String   @default("core") // "core" | "peripheral" | "unrelated" (to this release)
  flags       String[] // "unclear_scope" | "bigger_than_pointed" | "smaller_than_pointed" | "hidden_work"
  model       String
  createdAt   DateTime @default(now())

  @@unique([scopeId, source, externalId])
}

model Source {
  id        String    @id @default(cuid())
  kind      String // "transcript" | "notes" | "estimates"
  title     String
  content   String
  scopeId   String?
  scope     Scope?    @relation(fields: [scopeId], references: [id])
  createdAt DateTime  @default(now())
  findings  Finding[]
}

model Finding {
  id            String   @id @default(cuid())
  // Nullable as of Phase 1b (was required through Phase 1a). A LEGACY/
  // DIRECT AUDIT Finding still always has one, set exactly as before. A
  // PACKAGE-DERIVED Finding (contextSnapshotId set, no pasted transcript
  // behind it) genuinely has no Source -- fabricating one just to satisfy
  // a NOT NULL constraint would misrepresent where the Finding came from,
  // so the constraint was relaxed instead. A Finding may carry both if a
  // deliberate flow genuinely used a transcript AND package evidence in
  // the same audit run.
  sourceId      String?
  source        Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  type          String // "missing_work" | "decision" | "risk" | "contradiction"
  title         String
  quote         String
  rationale     String
  severity      String // "high" | "medium" | "low"
  estimateHint  String?
  owner         String? // for decisions: who seems to own the call
  blocks        String? // for decisions/risks: what this is holding up
  blocking      Boolean  @default(false) // true = actively blocks scoped work
  matchedIssues String[]
  status        String   @default("open") // open | ticketed | dismissed | resolved
  linearIssueId String?
  dismissReason String?
  resolution    String? // for decisions: what was decided, when marked resolved
  resolvedAt    DateTime? // set when status -> resolved; powers "resolved since last report"
  createdAt     DateTime @default(now())

  // Which ContextSnapshot this Finding was derived from, and which
  // evidence items within its package it cites (EvidenceItem.id values,
  // e.g. "infra-row-13"). Set by runAudit() as of Phase 1b whenever the
  // audit run had a ProjectContextPackage attached. Deliberately NOT a
  // sourceRegistrationId: the snapshot already carries the full source
  // manifest (with registrationId per entry), so a Finding pointing at
  // the snapshot + specific evidence ids is strictly more precise than a
  // source-level FK alone.
  contextSnapshotId String?
  contextSnapshot   ContextSnapshot? @relation(fields: [contextSnapshotId], references: [id])
  evidenceRefs      String[] @default([])
}

// A CHOICE, not an observation.
//
// A Finding is something the audit NOTICED. A Decision is something the
// project has to DECIDE. Those were the same row for a long time
// (Finding.type = "decision"), and overloading them is what let "this is a
// decision" silently mean "this delays delivery" -- the address-storage
// question and a blocking vendor choice were indistinguishable to the
// forecast.
//
// THE LAW THIS MODEL EXISTS TO ENFORCE:
//
//   An OPEN Decision has NO forecast effect.
//
// A Decision touches the forecast only through DecisionGate below, which
// has to say what waits, why the wait is serial, and on what evidence.
// "How should addresses be stored?" can be open, real and important
// forever while changing no date at all.
model Decision {
  id        String   @id @default(cuid())
  scopeId   String
  scope     Scope    @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  // The question, phrased as a question.
  title     String
  status    String   @default("open") // open | decided | dismissed
  owner     String?
  rationale String?
  // When the answer is needed by. Advisory only -- it feeds no simulation.
  neededBy  DateTime?
  // Choices under consideration. Options are optional: plenty of real
  // decisions are "we have to decide X" long before anyone has enumerated
  // the ways X could go. Shape: [{ id, label, note? }].
  options   Json     @default("[]")
  chosenOption String?
  resolution   String?
  decidedAt    DateTime?
  dismissReason String?
  // Linear identifiers this choice touches. Display + navigation only.
  relatedIssues String[] @default([])

  // WHERE THIS CAME FROM. A Decision migrated from a legacy Finding keeps
  // a pointer to it so the migration is idempotent and reversible, and so
  // history survives -- the Finding row is never deleted.
  sourceFindingId String?  @unique
  // The candidate this was promoted from, when it began as a machine
  // suggestion. Also the idempotency key for acceptance.
  sourceClaimKey  String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gate     DecisionGate?
  evidence DecisionEvidence[]

  @@index([scopeId, status])
}

// THE ONLY WAY A DECISION REACHES THE FORECAST.
//
// Its existence is the claim "delivery is physically waiting on this
// choice". Every field is required because a gate that cannot say what
// waits, why the wait is serial, or on what evidence, is an assertion
// nobody can check -- and the old model made exactly that assertion from
// a boolean.
//
// ENGINE LIMIT, stated honestly: lib/forecast/simulate.ts adds gate
// samples serially, to the whole scope. So only a genuinely serial,
// scope-wide dependency belongs here. A choice that could be resolved in
// parallel with the work stays an open Decision with no gate rather than
// being forced through serial math that would misreport it.
model DecisionGate {
  id         String   @id @default(cuid())
  decisionId String   @unique
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  // WHAT WAITS. Structured, not free text: the forecast reads this.
  // Scope-level only in V1 -- Features have no durable identity yet, and
  // fake precision is worse than a smaller true model.
  targetScopeId String
  targetScope   Scope  @relation("GatedScope", fields: [targetScopeId], references: [id], onDelete: Cascade)

  // WHY IT IS SERIAL, and WHAT SUPPORTS THAT. Prose, but required prose:
  // a human has to be able to audit the claim.
  dependency      String
  evidenceForGate String

  // How long resolving the choice could take. Sampled exactly like any
  // other three-point estimate. Legacy migrated gates carry 1/4/10, which
  // is what the old hard-coded constant used, so no date moves.
  low    Float
  likely Float
  high   Float

  // True for every gate today; the column exists so a future concurrent
  // model can be added without a migration that silently reinterprets
  // existing rows.
  serial Boolean @default(true)

  // "migrated" marks a gate created by the legacy backfill rather than by
  // someone answering the connect-to-delivery questions.
  provenance String @default("manual") // manual | migrated
  createdAt  DateTime @default(now())

  @@index([targetScopeId])
}

// One citation. A Decision may carry several, from different sources --
// the same choice argued in a transcript, a Linear comment and a
// spreadsheet is ONE Decision with three pieces of evidence, not three
// decisions.
model DecisionEvidence {
  id         String   @id @default(cuid())
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  kind    String // "context_package" | "linear" | "manual" | "finding"
  excerpt String
  // Provenance, as specific as the source allows. All optional because
  // different sources can honestly supply different amounts.
  contextSnapshotId String?
  evidenceItemId    String?
  externalRef       String?
  sourceLabel       String?
  createdAt DateTime @default(now())

  @@index([decisionId])
}

// A machine suggestion that has NOT been accepted as Reality.
//
// Hermes noticing a debate must never create project truth. A candidate is
// the visible form of a DerivedClaim (lib/context/package.ts), which that
// module already documents as "never itself a Finding, forecast input,
// Linear ticket, or Reality". This row exists only so a candidate can be
// dismissed durably and so acceptance can be idempotent -- it is a
// disposition record, not a Decision.
model DecisionCandidate {
  id       String @id @default(cuid())
  // Stable across re-imports of the same claim: snapshot + claim id.
  claimKey String @unique

  scopeId String
  scope   Scope  @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  title      String
  question   String?
  sourceLabel String // "Hermes · Refinement call", "Linear #2431", ...
  contextSnapshotId String?
  // EvidenceItem ids within the snapshot's package, carried verbatim so
  // acceptance can copy real citations rather than inventing them.
  evidenceRefs String[] @default([])
  excerpts     String[] @default([])

  status     String   @default("pending") // pending | accepted | dismissed
  acceptedDecisionId String?
  createdAt  DateTime @default(now())

  @@index([scopeId, status])
}

model AuditRun {
  id           String   @id @default(cuid())
  // Nullable as of Phase 1b -- a loose string reference (not a real
  // Prisma relation), so relaxing it is a plain column-constraint change.
  // Null for a package-only audit run that created no Source row.
  sourceId     String?
  // Which ContextSnapshot this run consumed package evidence from, when
  // any (Phase 1c) -- so a package-driven AuditRun is never provenance-
  // orphaned the way a bare-null sourceId alone would leave it. A legacy
  // audit run has sourceId set and this null; a package-only run has this
  // set and sourceId null; a mixed run may have both.
  contextSnapshotId String?
  contextSnapshot   ContextSnapshot? @relation(fields: [contextSnapshotId], references: [id])
  issueCount   Int
  findingCount Int
  model        String
  createdAt    DateTime @default(now())
}

// ── TIMELINE ───────────────────────────────────────────────────────────
//
// Timeline is a PROJECTION over records that already exist. A Report, a
// Decision, a Finding, a context observation and a completed Linear issue
// are all timestamped facts owned by their own instrument, and Timeline
// reads them (lib/timeline/entries.ts) rather than copying them. There is
// deliberately no event ledger here: duplicating a Decision's createdAt
// into a second table would create a second source of truth that could
// disagree with the first.
//
// This model exists for the one class of landmark nothing else owns -- a
// kickoff, a launch, a phase, a delivery someone states by hand or accepts
// from a machine suggestion. Those have no home anywhere else in the
// schema, so Timeline owns them.
model TimelineEvent {
  id      String @id @default(cuid())
  scopeId String
  scope   Scope  @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  kind  String // event | milestone | kickoff | delivery | phase
  title String
  date  DateTime
  // Set only for a genuine duration. Most landmarks are points; a span is
  // NOT the default, because a timeline of bars is a Gantt chart.
  endDate DateTime?

  // STORED, NEVER COMPUTED. `date < now ? "occurred" : "planned"` is the
  // one inference this model refuses to make: a planned milestone whose
  // date has passed is OVERDUE, which is information worth keeping, not a
  // thing that silently became history because the clock moved.
  temporalState String @default("occurred") // occurred | planned

  note String?

  // WHERE IT CAME FROM. A landmark someone typed and a landmark accepted
  // from a Hermes claim are both Reality, but they are not equally
  // attested, and the difference has to survive.
  source            String  @default("manual") // manual | candidate | import
  sourceLabel       String?
  contextSnapshotId String?
  contextSnapshot   ContextSnapshot? @relation(fields: [contextSnapshotId], references: [id])
  evidenceRefs      String[] @default([])
  externalRef       String?
  // The candidate this was seated from; also the idempotency key, so a
  // retried acceptance updates rather than duplicating.
  sourceClaimKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scopeId, date])
}

// A machine noticed something that looks like a project landmark. That is
// a DISPOSITION RECORD, not Timeline Reality -- exactly the boundary
// DecisionCandidate draws, for exactly the same reason.
//
// `date` is nullable on purpose. A DerivedClaim carries no date, and
// inferring one from prose ("we kicked off last week") would be the model
// inventing history. A dateless candidate waits in Event Intake until a
// human supplies the date; it cannot be accepted without one.
model TimelineEventCandidate {
  id       String @id @default(cuid())
  claimKey String @unique

  scopeId String
  scope   Scope  @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  title String
  date  DateTime?
  // A SUGGESTED END, held to the same standard as the suggested start: it
  // exists only when structured evidence metadata stated one. Never derived
  // from prose, never a default duration — an activity whose length nobody
  // wrote down arrives as a moment, not as a guessed span.
  endDate DateTime?
  kind    String @default("event")

  sourceLabel       String
  contextSnapshotId String?
  evidenceRefs      String[] @default([])
  excerpts          String[] @default([])

  status          String   @default("pending") // pending | accepted | dismissed
  acceptedEventId String?
  createdAt       DateTime @default(now())

  @@index([scopeId, status])
}
